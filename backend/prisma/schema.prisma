generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String    @map("password_hash")
  level        Int       @default(1)
  xp           Int       @default(0)
  xpToNext     Int       @default(500) @map("xp_to_next")
  streak       Int       @default(0)
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  portfolio    Portfolio?
  transactions Transaction[]
  achievements UserAchievement[]
  watchlists   Watchlist[]
  notifications Notification[]

  @@index([email])
  @@map("users")
}

model Portfolio {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  cashBalance     Decimal  @default(100000) @map("cash_balance") @db.Decimal(18, 4)
  totalValue      Decimal  @default(100000) @map("total_value") @db.Decimal(18, 4)
  realizedGain    Decimal  @default(0) @map("realized_gain") @db.Decimal(18, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id])
  holdings        Holding[]
  snapshots       PortfolioSnapshot[]

  @@index([userId])
  @@map("portfolios")
}

model Holding {
  id             String   @id @default(uuid())
  portfolioId    String   @map("portfolio_id")
  ticker         String
  shares         Decimal  @db.Decimal(18, 4)
  averageCost    Decimal  @map("average_cost") @db.Decimal(18, 4)
  totalCostBasis Decimal  @map("total_cost_basis") @db.Decimal(18, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  portfolio      Portfolio @relation(fields: [portfolioId], references: [id])

  @@unique([portfolioId, ticker])
  @@index([portfolioId])
  @@map("holdings")
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  portfolioId String          @map("portfolio_id")
  type        TransactionType
  ticker      String
  shares      Decimal         @db.Decimal(18, 4)
  price       Decimal         @db.Decimal(18, 4)
  total       Decimal         @db.Decimal(18, 4)
  executedAt  DateTime        @default(now()) @map("executed_at")

  user        User @relation(fields: [userId], references: [id])

  @@index([portfolioId])
  @@map("transactions")
}

enum TransactionType {
  BUY
  SELL
}

model PortfolioSnapshot {
  id          String       @id @default(uuid())
  portfolioId String       @map("portfolio_id")
  totalValue  Decimal      @map("total_value") @db.Decimal(18, 4)
  period      SnapshotPeriod
  createdAt   DateTime     @default(now()) @map("created_at")

  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])

  @@map("portfolio_snapshots")
}

enum SnapshotPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ticker    String
  createdAt DateTime @default(now()) @map("created_at")

  user      User @relation(fields: [userId], references: [id])

  @@unique([userId, ticker])
  @@index([userId])
  @@map("watchlists")
}

model Achievement {
  id          String  @id @default(uuid())
  title       String
  description String
  xpReward    Int     @map("xp_reward")
  icon        String  @default("trophy")

  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  message   String
  read      Boolean  @default(false)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}
